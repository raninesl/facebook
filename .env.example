# =============================================================================
#  CONFIGURATION VERCEL (obligatoire pour que les données persistent en production
# =============================================================================
#
# Sur Vercel, le système de fichiers est en lecture seule : impossible d'écrire
# captured_data.json. Il faut utiliser une base de données externe.
#
# 2 options supportées automatiquement par le code (il suffit de définir ces 2 var:
#
#   - VERCEL KV (natif Vercel)  → variables KV_REST_API_URL + KV_REST_API_TOKEN
#   - UPSTASH REDIS (marchéplace)  → variables UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN
#
# =============================================================================
# ETAPE 1 : Créer un magasin Redis/KV
# =============================================================================
#
# Option A (natif Vercel):
#   1. Aller sur ton projet Vercel → Storage
#   2. Onglet "Storage" → Create Database → KV (Redis)
#   3. Choisir une région proche (ex: Paris, EU)
#   4. Connecter la base à ton projet
#   5. Les variables KV_REST_API_URL / KV_REST_API_TOKEN sont injectées auto.
#
# Option B (Upstash, même technologie):
#   1. Aller sur https://console.upstash.com/redis (ou Vercel → Marketplace → Upstash Redis)
#   2. Créer une base Redis gratuite
#   3. Copier REST URL et REST TOKEN dans les variables ci-dessous
#
# =============================================================================
# ETAPE 2 : Copier ce fichier en .env.local OU définir dans Vercel Project Settings → Environment Variables
# =============================================================================

# ===== Vercel KV / Upstash Redis REST (2 variables suffisent)
KV_REST_API_URL=https://xxxxxxx.kv.vercel-storage.com
KV_REST_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Alternative: si Upstash via marketplace hors Vercel
# UPSTASH_REDIS_REST_URL=https://xxxxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (optionnel) chemin du fichier de stockage local (dev uniquement, ignoré sur Vercel)
# STORAGE_FILE=./captured_data.json
